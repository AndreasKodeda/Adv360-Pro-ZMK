#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SMB 1
#define LANG 2
#define NAV 3
#define NUM 4
#define FN 5
#define MOD 6
#define SMBVIM 7

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          tapping-term-ms = <120>;
          quick-tap-ms = <80>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
      mokp: move_mods {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          tapping-term-ms = <120>;
          quick-tap-ms = <80>;
          flavor = "tap-preferred";
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    arensito {
      display-name = "arensito";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                      ╭───────┬────────┬─────────────┬──────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                      │       │        │             │              │            │               │           │
            &none       &none        &none        &none          &none         &none      &tog NUM                                                                                          &mo MOD &none    &none         &none          &none        &none           &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                      ├───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                      │       │        │             │              │            │               │           │
            &none       &kp Z        &kp L        &kp COMMA      &kp P         &none      &none                                                                                             &none   &none    &kp F         &kp U          &kp D        &kp X           &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                 ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│ LGUI      │            │            │              │             │          │          │                 │           │          │  │           │            │                 │       │        │             │              │            │               │ LGUI      │
            &kp LGUI    &hm LGUI A   &hm LALT R   &hm LSHIFT E   &hm LCTRL N   &kp B      &none                        &kp PSCRN    &kp INS      &none       &none                          &none   &kp G    &hm RCTRL S   &hm RSHIFT I   &hm RALT T   &hm RGUI O      &kp LGUI
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭───────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │     !        │             │          │                │           │           │          │  │           │            │           │             │        │             │              │            │               │           │
            &none       &kp Q        &kp W        &mokp NUM TAB  &mokp SMB H   &kp J                                               &kp HOME      &none                                              &kp V    &mokp SMB C   &kp Y          &kp M        &kp K           &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │           │           ├──────────┤  ├───────────┤            │           │             ╰────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │ { [        │ ] }        │ | \          │             │                           │  nav      │  num      │          │  │           │ mouse      │ smbvim    │                      │             │              │            │               │           │
            &mo FN      &none        &none        &none          &kp CAPS                                   &mokp NAV SPACE &mokp NUM TAB &none  &none       &kp ENTER    &mokp SMBVIM BSPC                 &none         &none         &none         &none           &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰───────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                      ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    symbols {
      display-name = "smb";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬─────────────┬──────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │             │              │            │               │           │
            &trans      &trans       &trans       &trans         &trans        &trans     &trans                                                                                           &trans  &trans        &trans        &trans         &trans       &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     &      │     $      │     '        │     #       │          │          │                                                                                     │       │             │             │     :        │            │               │           │
            &trans      &kp AMPS     &kp DLLR     &kp APOS       &kp HASH      &trans     &trans                                                                                           &trans  &trans        &trans        &kp COLON      &trans       &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     \      │     /      │     (        │     )       │     @    │          │                │           │          │  │           │            │                 │       │             │     {       │     }        │     ]      │     [         │           │
            &trans      &kp BSLH     &kp FSLH     &kp LPAR       &kp RPAR      &kp AT     &trans                      &trans      &trans        &trans      &trans                         &trans  &trans        &kp LBRC      &kp RBRC       &kp RBKT     &kp LBKT        &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     <      │     >      │     "        │     =       │          │                │          │           │          │  │           │            │           │             │             │     ;       │    ,         │    .       │               │           │
            &trans      &kp LT       &kp GT       &kp DQT        &kp EQUAL     &trans                                             &trans        &trans                                             &trans        &kp SEMI      &kp COMMA      &kp DOT      &kp PLUS          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     !      │     %      │     ?        │     |       │                           │          │           │          │  │           │            │           │                           │     -       │     _        │            │               │           │
            &trans      &kp EXCL     &kp PRCNT    &kp QMARK      &kp PIPE                                  &trans     &trans      &kp END       &kp PG_DN   &trans       &trans                                  &kp MINUS     &kp UNDER      &kp ASTRK    &trans          &trans
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    language {
      display-name = "lang";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp EQUAL   &kp N1       &kp N2       &kp N3         &kp N4        &kp N5     &tog NUM                                                                                         &mo MOD   &kp N6        &kp N7         &kp N8        &kp N9       &kp N0       &kp MINUS
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp TAB     &kp Q        &kp W        &kp E          &kp R         &kp T      &none                                                                                            &none   &kp Y         &kp U         &kp I          &kp O        &kp P            &kp BSLH
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                │           │          │  │           │            │                 │       │             │             │              │            │               │           │
            &kp ESC     &trans        &kp S        &kp D          &kp F         &kp G      &none                       &kp LCTRL   &kp LALT      &kp LGUI     &kp RCTRL                     &none   &kp H         &kp J         &kp K          &kp L        &kp SEMI        &kp SQT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │                │          │           │          │  │           │            │           │             │             │             │              │            │               │           │
            &kp LSHFT   &kp Z        &kp X        &kp C          &kp V         &kp B                                              &kp HOME      &kp PG_UP                                          &kp N         &kp M         &kp COMMA      &kp DOT      &kp FSLH        &kp RSHFT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │                           │          │           │          │  │           │            │           │                           │             │              │            │               │           │
            &mo FN      &kp GRAVE    &kp CAPS     &kp LEFT       &kp RIGHT                                 &kp BSPC   &kp DEL     &kp END       &kp PG_DN   &kp ENTER    &kp SPACE                               &kp UP        &kp DOWN       &kp LBKT     &kp RBKT        &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    navigation {
      display-name = "nav";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │ Escape     │ Insert     │ Shift-Tab    │ Delete      │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp EQUAL   &kp ESC       &kp INSERT  &none          &kp DELETE   &none      &none                                                                                           &none    &none         &none          &none         &none        &none           &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │ Enter      │ Space      │ Tab          │ backspace   │ cut      │          │                                                                                     │       │ Cut         │ Shift-Tab    │ Undo        │ Redo       │ Tab           │           │
            &kp TAB     &kp ENTER    &kp SPACE    &kp TAB        &kp BSPC      &none      &none                                                                                            &none   &none         &none         &none          &none        &kp TAB         &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │ copy     │          │                │           │          │  │ extend-line│extend-word│                 │       │ Copy        │ Left        │ Up           │ Down       │ Right         │           │
            &kp ESC     &kp LGUI     &kp LALT     &kp LSHIFT     &kp LCTRL     &none      &none                       &none       &none         &none       &none                          &none   &none         &kp LEFT      &kp UP         &kp DOWN     &kp RIGHT       &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│ Address-Bar│ Select-all│ Select-Line│ Select-word  │ Find        │ paste    │                │          │           │          │  │ sel-none  │            │           │             │ Paste       │ Home        │ Page-Up      │ Page-Down  │ End           │ Adress-Bar│
            &none       &none        &none        &none          &none         &none                                              &none         &none                                              &none         &kp HOME      &kp PG_UP      &kp PG_DN    &kp END         &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│ Search-Bar│ Undo       │ Redo       │ Find-Prev    │ Find-Next   │                           │          │           │          │  │ sel-all   │ sel-line   │ sel-word  │                           │ Find        │ Find-Prev    │ Find-Next  │ Find & Replace│ Search-Bar│
            &none       &none        &none        &none          &none                                     &none      &none       &none         &none       &none        &none                                   &none         &none          &none        &none           &none 
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    numpad {
      display-name = "num";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │ |           │ #            │ $           │ ^          │ ~             │ !         │
            &trans      &trans       &trans       &trans         &trans        &trans     &none                                                                                           &none    &kp PIPE     &kp HASH        &kp DLLR        &kp CARET   &kp TILDE      &kp EXCL
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │ Escape     │ Insert     │ shift-tab    │ delete      │          │          │                                                                                     │       │ G           │              │             │            │ :             │ %         │
            &trans      &kp ESCAPE   &kp INSERT   &none          &kp DELETE    &trans     &none                                                                                            &none   &kp G         &kp N7         &kp N8        &kp N9       &kp COLON       &kp PRCNT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │ Enter      │ Space      │ Tab          │  Backspace  │ x        │          │                │           │          │  │ <         │ >          │                 │       │ k           │             │              │            │ -             │ +         │
            &trans      &kp ENTER    &kp SPACE    &kp TAB        &kp BSPC      &kp X      &none                       &trans      &trans        &kp LT      &kp GT                         &none   &kp K        &kp N4        &kp N5         &kp N6       &kp KP_PLUS     &kp PLUS
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │ select-all │ sel-line   │ sel-word     │  find       │          │                │          │           │          │  │ ,         │            │           │             │ j           │             │              │            │               │ *         │
            &trans      &trans        &trans      &trans          &none        &none                                              &none         &kp COMMA                                          &kp J         &kp N1        &kp N2         &kp N3       &kp MINUS       &kp ASTRK
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │ undo       │ redo       │ (            │ )           │                           │          │           │          │  │ .         │ =          │           │                           │ {           │ [            │ ]          │ }             │ @         │
            &trans      &none         &none        &kp LPAR       &kp RPAR                                  &none      &none       &none         &kp DOT     &kp EQUAL    &kp N0                                  &kp LBRC      &kp LBKT       &kp RBKT     &kp RBRC        &kp AT
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo MOD &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    symbol_vim {
      display-name = "smbvim";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │ (          │ )            │ ;           │ ,        │          │                                                                                     │       │             │              │             │            │               │           │
            &trans      &trans       &kp LPAR     &kp RPAR       &kp SEMI      &kp COMMA  &none                                                                                            &none   &trans        &trans         &trans        &trans       &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│ !         │ [          │ {          │ }            │ ]           │ ?        │          │                                                                                     │       │ .           │              │ Shifttab    │            │               │           │
            &kp EXCL    &kp LBKT     &kp LBRC     &kp RBRC       &kp RBKT      &kp QMARK  &none                                                                                            &none   &kp DOT       &kp DEL        &none         &kp INSERT   &kp ESC         &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│ #         │ ^          │ =          │ _            │ $           │ *        │          │                │ \         │ .        │  │           │            │                 │       │ ,           │             │              │            │               │           │
            &kp HASH    &kp CARET    &kp EQUAL    &kp UNDER      &kp DLLR      &kp ASTRK  &none                       &kp BSLH    &kp DOT       &none       &none                          &none   &kp COMMA     &kp BSPC      &kp TAB        &kp SPACE    &kp ENTER       &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│ ~         │ <          │  |         │ -            │ >           │ /        │                │          │           │          │  │           │            │           │             │ ;           │ "           │ '            │ `          │ \             │           │
            &kp TILDE   &kp LT       &kp PIPE     &kp MINUS      &kp GT        &kp FSLH                                           &none         &none                                              &kp SEMI      &kp DQT       &kp APOS       &kp GRAVE    &kp BSLH        &none
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │ &          │ '          │ "            │ +           │                           │ %        │ :         │ @        │  │           │            │           │                           │ shift       │ ctr          │ alt        │  WIN          │           │
            &none       &kp AMPS     &kp APOS     &kp DQT        &kp PLUS                                  &kp PRCNT  &kp COLON   &kp AT        &none       &none        &none                                   &kp RSHIFT    &kp RCTRL      &kp RALT     &kp RGUI          &none
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
  };
};
