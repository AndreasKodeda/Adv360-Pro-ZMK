#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SMB 1
#define LANG 2
#define NAV 3
#define NUM 4
#define FN 5
#define MOD 6

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <120>;
          quick_tap_ms = <80>;
          flavor = "hold-preferred";
          bindings = <&kp>, <&kp>;
      };
      mokp: move_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "MOVE_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <120>;
          quick_tap_ms = <80>;
          flavour = "hold-preferred";
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    arensito {
      display-name = "arensito";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                      ╭───────┬────────┬─────────────┬──────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                      │       │        │             │              │            │               │           │
            &kp EQUAL   &kp N1       &kp N2       &kp N3         &kp N4        &kp N5     &tog NUM                                                                                          &mo MOD &kp N6   &kp N7        &kp N8        &kp N9       &kp N0           &kp MINUS
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                      ├───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                      │       │        │             │              │            │               │           │
            &kp ESC     &kp Z        &kp L        &kp COMMA      &kp P         &none      &none                                                                                             &none   &kp PIPE &kp F         &kp U          &kp D        &kp X           &kp BSLH
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                 ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                 │           │          │  │           │            │                 │       │        │             │              │            │               │           │
            &kp TAB     &hm LGUI A   &hm LALT R   &hm LSHIFT E   &hm LCTRL N   &kp B      &none                        &kp LALT    &kp LALT      &kp RALT     &kp RCTRL                     &none   &kp G    &hm RCTRL S   &hm RSHIFT I   &hm RALT T   &hm RGUI O      &kp SQT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭───────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │     !        │             │          │                │           │           │          │  │           │            │           │             │        │             │              │            │               │           │
            &kp LSHFT   &kp Q        &kp W        &kp EXCL       &mokp SMB H   &kp J                                               &kp HOME      &none                                              &kp V    &mokp SMB C   &kp Y          &kp M        &kp K           &kp RSHFT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │           │           ├──────────┤  ├───────────┤            │           │             ╰────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │                           │           │           │          │  │           │            │           │                      │             │              │            │               │           │
            &mo FN      &kp GRAVE    &kp CAPS     &kp LEFT       &kp RIGHT                                 &kp SPACE   &kp LGUI  &mo SMB       &mo SMB     &kp ENTER    &kp BSPC                           &kp UP        &kp DOWN       &kp LBKT     &kp RBKT        &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰───────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                      ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    symbols {
      display-name = "smb";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬─────────────┬──────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │             │              │            │               │           │
            &trans      &trans       &trans       &trans         &trans        &trans     &trans                                                                                           &trans  &trans        &trans        &trans         &trans       &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     &      │     $      │     '        │     #       │          │          │                                                                                     │       │             │     \       │     /        │     :      │               │           │
            &trans      &kp AMPS     &kp DLLR     &kp APOS       &kp HASH      &trans     &trans                                                                                           &trans  &trans        &kp BSLH      &kp FSLH       &kp COLON    &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     \      │     /      │     (        │     )       │     @    │          │                │           │          │  │           │            │                 │       │             │     {       │     }        │     ]      │     [         │           │
            &trans      &kp BSLH     &kp FSLH     &kp LPAR       &kp RPAR      &kp AT     &trans                      &trans      &trans        &trans      &trans                         &trans  &trans        &kp LBRC      &kp RBRC       &kp RBKT     &kp LBKT        &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     <      │     >      │     "        │     =       │          │                │          │           │          │  │           │            │           │             │             │     ;       │    ,         │    .       │               │           │
            &trans      &kp LT       &kp GT       &kp DQT        &kp EQUAL     &trans                                             &trans        &trans                                             &trans        &kp SEMI      &kp COMMA      &kp DOT      &trans          &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │     !      │     %      │     ?        │     |       │                           │          │           │          │  │           │            │           │                           │     -       │     _        │            │               │           │
            &trans      &kp EXCL     &kp PRCNT    &kp QMARK      &kp PIPE                                  &trans     &trans      &kp END       &kp PG_DN   &trans       &trans                                  &kp MINUS     &kp UNDER      &kp ASTRK    &trans          &trans
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    language {
      display-name = "lang";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp EQUAL   &kp N1       &kp N2       &kp N3         &kp N4        &kp N5     &tog NUM                                                                                         &mo MOD   &kp N6        &kp N7         &kp N8        &kp N9       &kp N0       &kp MINUS
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp TAB     &kp Q        &kp W        &kp E          &kp R         &kp T      &none                                                                                            &none   &kp Y         &kp U         &kp I          &kp O        &kp P            &kp BSLH
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                │           │          │  │           │            │                 │       │             │             │              │            │               │           │
            &kp ESC     &trans        &kp S        &kp D          &kp F         &kp G      &none                       &kp LCTRL   &kp LALT      &kp LGUI     &kp RCTRL                     &none   &kp H         &kp J         &kp K          &kp L        &kp SEMI        &kp SQT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │                │          │           │          │  │           │            │           │             │             │             │              │            │               │           │
            &kp LSHFT   &kp Z        &kp X        &kp C          &kp V         &kp B                                              &kp HOME      &kp PG_UP                                          &kp N         &kp M         &kp COMMA      &kp DOT      &kp FSLH        &kp RSHFT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │                           │          │           │          │  │           │            │           │                           │             │              │            │               │           │
            &mo FN      &kp GRAVE    &kp CAPS     &kp LEFT       &kp RIGHT                                 &kp BSPC   &kp DEL     &kp END       &kp PG_DN   &kp ENTER    &kp SPACE                               &kp UP        &kp DOWN       &kp LBKT     &kp RBKT        &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    navigation {
      display-name = "nav";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp EQUAL   &kp N1       &kp N2       &kp N3         &kp N4        &kp N5     &tog NUM                                                                                         &mo MOD   &kp N6        &kp N7         &kp N8        &kp N9       &kp N0       &kp MINUS
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &kp TAB     &kp Q        &kp W        &kp E          &kp R         &kp T      &none                                                                                            &none   &kp Y         &kp U         &kp I          &kp O        &kp P            &kp BSLH
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                │           │          │  │           │            │                 │       │             │             │              │            │               │           │
            &kp ESC     &hm LGUI A   &hm LALT S   &hm LSHIFT D   &hm LCTRL F   &kp G      &none                       &kp LCTRL   &kp LALT      &kp LGUI     &kp RCTRL                     &none   &kp H         &hm RCTRL J   &hm RSHIFT K   &hm RALT L   &hm RGUI SEMI    &kp SQT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │                │          │           │          │  │           │            │           │             │             │             │              │            │               │           │
            &kp LSHFT   &kp Z        &kp X        &kp C          &kp V         &kp B                                              &kp HOME      &kp PG_UP                                          &kp N         &kp M         &kp COMMA      &kp DOT      &kp FSLH        &kp RSHFT
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │                           │          │           │          │  │           │            │           │                           │             │              │            │               │           │
            &mo FN       &kp GRAVE    &kp CAPS     &kp LEFT       &kp RIGHT                                 &kp BSPC   &kp DEL     &kp END       &kp PG_DN   &kp ENTER    &kp SPACE                               &kp UP        &kp DOWN       &kp LBKT     &kp RBKT        &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    numpad {
      display-name = "num";
      bindings = <
        //╭───────────┬────────────┬────────────┬──────────────┬─────────────┬──────────┬──────────╮                                                                                     ╭───────┬─────────────┬──────────────┬─────────────┬────────────┬───────────────┬───────────╮
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &trans      &trans       &trans       &trans         &trans        &trans     &tog NUM                                                                                         &mo MOD   &trans        &trans         &trans        &trans       &trans       &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                                                                                     ├───────┼─────────────┼──────────────┼─────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                                                                                     │       │             │              │             │            │               │           │
            &trans      &trans       &trans       &trans         &trans        &trans     &none                                                                                            &none   &kp Y         &kp N7         &kp N8        &kp N9       &trans            &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────┤                ╭───────────┬──────────╮  ╭───────────┬────────────╮                 ├───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │          │                │           │          │  │           │            │                 │       │             │             │              │            │               │           │
            &trans      &hm LGUI A   &hm LALT S   &hm LSHIFT D   &hm LCTRL F   &trans     &none                       &trans      &trans        &trans      &kp N0                            &none   &kp H         &kp N4        &kp N5         &kp N6       &kp KP_PLUS        &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────┼──────────╯     ╭──────────┼───────────┼──────────┤  ├───────────┼────────────┼───────────╮     ╰───────┼─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │          │                │          │           │          │  │           │            │           │             │             │             │              │            │               │           │
            &trans      &trans        &trans      &trans          &trans       &trans                                              &trans       &trans                                             &kp N         &kp N1        &kp N2         &kp N3       &kp MINUS        &trans
        //├───────────┼────────────┼────────────┼──────────────┼─────────────┼──────────╯                │          │           ├──────────┤  ├───────────┤            │           │             ╰─────────────┼─────────────┼──────────────┼────────────┼───────────────┼───────────┤
        //│           │            │            │              │             │                           │          │           │          │  │           │            │           │                           │             │              │            │               │           │
            &trans      &trans       &trans       &trans         &trans                                    &kp BSPC   &kp DEL     &trans        &trans      &kp ENTER    &kp SPACE                               &kp N0        &kp FSLH       &kp STAR     &trans          &mo FN
        //╰───────────┴────────────┴────────────┴──────────────┴─────────────╯                           ╰──────────┴───────────┴──────────╯  ╰───────────┴────────────┴───────────╯                           ╰─────────────┴──────────────┴────────────┴───────────────┴───────────╯
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo MOD &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
  };
};
